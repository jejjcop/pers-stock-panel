# Installed by Composer; recreate with `composer install`.
/vendor/

# Laravel's settings for this computer, including its secret key. Each copy
# makes its own from .env.example.
/.env
/.env.backup
/storage/*.key
/public/hot
/public/storage

# Your stock lists, shares and costs, written by the page as you use it.
/data/

# Installed by npm; recreate with `npm install`.
/node_modules/

# Browser test results and reports from Playwright.
/test-results/
/playwright-report/

# Claude Code: the test hook's record of what it last tested, and personal settings.
/.claude/hooks/.last-tested
/.claude/settings.local.json

# PHPUnit's cache of previous test results.
/.phpunit.result.cache
/.phpunit.cache/
